# Google Cloud Text-to-Speech API Key
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
# Asegúrate de restringir la clave a "Cloud Text-to-Speech API"
VITE_GOOGLE_TTS_API_KEY=tu_api_key_aqui

# Supabase API
# Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui
