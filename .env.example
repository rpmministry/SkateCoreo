# Google Cloud Text-to-Speech API Key (credencial PROPIA DE LA APP)
#
# IMPORTANTE: SIN el prefijo VITE_, para que NUNCA se empaquete en el bundle del
# cliente. La consume exclusivamente la función serverless `api/tts.ts`
# (y el middleware de desarrollo de Vite). Los usuarios finales no configuran nada.
#
#  - Desarrollo local: defínela en .env (ignorado por git) y `npm run dev` ya
#    expone POST /api/tts con paridad total respecto a producción.
#  - Producción: Vercel → Project → Settings → Environment Variables.
#  - Si ya tenías VITE_GOOGLE_TTS_API_KEY, renómbrala y ELIMINA la versión con
#    prefijo VITE_ (esa sí era pública).
#
# Obtén la clave en https://console.cloud.google.com/apis/credentials y
# restríngela a "Cloud Text-to-Speech API".
GOOGLE_TTS_API_KEY=tu_api_key_aqui

# (Opcional) Orígenes extra permitidos por el proxy, separados por coma.
# El propio dominio siempre está permitido automáticamente.
# TTS_ALLOWED_ORIGINS=https://midominio.com

# (Opcional) Ruta del endpoint propio si cambias el despliegue.
# VITE_TTS_PROXY_PATH=/api/tts

# Supabase API
# Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://lgpdjohkqzblflxuioko.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_gNbf2h5b2WACjER4zpOGwQ_bSY9xMzV

# PayPal Business API
# Client ID de tu aplicación PayPal Developer (Rest API)
# Usa 'sb' para sandbox en modo desarrollo
VITE_PAYPAL_CLIENT_ID=BAANBBvlQwC7wtYK5V8p_DMs9rLn9bZkSCVUvldITeZ6OA_Rnig3y7poXvxK8xUdP-kM6F59kGe5QdB5mM