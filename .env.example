# Google Cloud Text-to-Speech API Key (credencial PROPIA DE LA APP)
#
# Esta clave se inyecta en tiempo de compilación y viaja con la aplicación:
# los usuarios finales NO tienen que introducir ninguna API Key.
#
#  - Desarrollo local: defínela en .env (ignorado por git).
#  - Producción: configúrala en Vercel → Project → Settings → Environment
#    Variables con el mismo nombre, y vuelve a desplegar.
#
# Obtén la clave en https://console.cloud.google.com/apis/credentials y
# restríngela a "Cloud Text-to-Speech API" (+ restricción HTTP por dominio,
# ya que Vite expone las variables VITE_* en el bundle del cliente).
VITE_GOOGLE_TTS_API_KEY=tu_api_key_aqui

# Supabase API
# Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://lgpdjohkqzblflxuioko.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_gNbf2h5b2WACjER4zpOGwQ_bSY9xMzV

# PayPal Business API
